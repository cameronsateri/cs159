import java.io.File;
import java.io.FileNotFoundException;
//import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.Scanner;

/**
 * Class containing the AccessibilityResults constructor.
 * 
 * @author cameron sateri
 * @version 2/17/23
 */
public class AccessibilityResults {
    private ArrayList<AccessibilityAssessment> assessments;

    public AccessibilityResults(String filename) throws FileNotFoundException {
        assessments = new ArrayList<AccessibilityAssessment>();
        Scanner s = new Scanner(new File(filename));
        while (s.hasNextLine()) {
            String category = s.next();
            String googleResult = s.next();
            String waveResult = s.next();
            String sortsiteResult = s.next();
            String aslintResult = s.next();
            String description = s.next();
            while (s.hasNext()) {
                description += s.next();
            }
            assessments.add(new AccessibilityAssessment(category, googleResult, waveResult, sortsiteResult,
                    aslintResult, description));
        }
        s.close();
    }
}
